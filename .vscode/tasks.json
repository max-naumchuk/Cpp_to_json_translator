{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-I/opt/homebrew/include",
                "-g",
                "${fileDirname}/main.cpp",
                "${fileDirname}/parser.tab.cpp",
                "${fileDirname}/lexer.yy.cpp",
                "-o",
                "${fileDirname}/fullparser"
                ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}